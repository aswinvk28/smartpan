<?php

function smartpan_stock_schema() {
    $schema['stock_profile'] = array(
        'description' => 'Stores the details of the stock',
        'fields' => array(
            'id' => array(
                'type' => 'serial',
                'not null' => true,
                'unsigned' => true),
            'symbol' => array(
                'type' => 'varchar',
                'not null' => true,
                'length' => 20),
            'industry' => array(
                'type' => 'varchar',
                'not null' => true,
                'default' => '',
                'length' => 255),
            'name' => array(
                'type' => 'varchar',
                'not null' => true,
                'default' => '',
                'length' => 255),
            'exchange' => array(
                'type' => 'varchar',
                'not null' => true,
                'default' => '',
                'length' => 50),
            'currency' => array(
                'type' => 'varchar',
                'description' => 'ISO Code of the currency',
                'not null' => true,
                'length' => 7,
                'default' => '')
        ),
        'indexes' => array(
            'currency' => array('currency'),
            'exchange' => array('exchange'),
            'symbol' => array('symbol', 'id')
        ),
        'primary key' => array('id'),
        'unique keys' => array(
            'stock' => array('symbol')
        )
    );
    
    $schema['stock_size'] = array(
        'description' => 'Stores the frequent stock data',
        'fields' => array(
            'id' => array(
                'type' => 'serial',
                'not null' => true,
                'unsigned' => true,
                'size' => 'big'),
            'stock_id' => array(
                'type' => 'int',
                'not null' => true,
                'unsigned' => true),
            'stock_symbol' => array(
                'type' => 'varchar',
                'not null' => true,
                'length' => 20),
            'price_value' => array(
                'mysql_type' => 'double',
                'type' => 'numeric',
                'precision' => 13,
                'scale' => 4,
                'not null' => false,
                'default' => NULL,
                'unsigned' => true),
            'price_change' => array(
                'mysql_type' => 'float',
                'type' => 'numeric',
                'precision' => 7,
                'scale' => 4,
                'not null' => false,
                'default' => NULL,
                'unsigned' => false),
            'volume_value' => array(
                'mysql_type' => 'int(15)',
                'type' => 'numeric',
                'not null' => false,
                'default' => NULL,
                'unsigned' => true),
            'trade_date' => array(
                'mysql_type' => 'date',
                'type' => 'numeric',
                'not null' => false,
                'default' => NULL),
            'trade_time' => array(
                'mysql_type' => 'time',
                'type' => 'numeric',
