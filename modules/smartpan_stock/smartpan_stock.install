                'default' => NULL),
            'created' => array(
                'type' => 'int',
                'type' => 'numeric',
                'description' => 'A timestamp for creation of subscription.',
                'not null' => true,
                'unsigned' => true,
                'default' => 0)
        ),
        'foreign keys' => array(
            'stock' => array(
                'table' => 'stock_profile',
                'columns' => array('id' => 'stock_id', 'symbol' => 'stock_symbol')
            )
        ),
        'primary key' => array('id'),
        'indexes' => array(
            'date' => array('trade_date'),
            'time' => array('trade_time'),
            'stock' => array('stock_symbol', 'stock_id')
        )
    );
    
    $schema['industry_rank'] = array(
        'description' => 'Stores frequent industry rank',
        'fields' => array(
            'id' => array(
                'type' => 'serial',
                'not null' => true,
                'unsigned' => true,
                'size' => 'big'),
            'stock_id' => array(
                'type' => 'int',
                'not null' => true,
                'unsigned' => true),
            'stock_symbol' => array(
                'type' => 'varchar',
                'not null' => true,
                'length' => 20),
            'value' => array(
                'mysql_type' => 'double',
                'type' => 'numeric',
                'precision' => 7,
                'scale' => 4,
                'not null' => true,
                'unsigned' => true),
            'created' => array(
                'type' => 'int',
                'not null' => true,
                'unsigned' => true)
        ),
        'foreign keys' => array(
            'stock' => array(
                'table' => 'stock_profile',
                'columns' => array('id' => 'stock_id', 'symbol' => 'stock_symbol')
            )
        ),
        'primary key' => array('id'),
        'indexes' => array(
            'date' => array('created'),
            'stock' => array('stock_symbol', 'stock_id')
        )
    );
    
    $schema['market_rank'] = array(
        'description' => 'Stores frequent market rank',
        'fields' => array(
            'id' => array(
                'type' => 'serial',
                'not null' => true,
                'unsigned' => true,
                'size' => 'big'),
            'stock_id' => array(
                'type' => 'int',
                'not null' => true,
                'unsigned' => true),
            'stock_symbol' => array(
                'type' => 'varchar',
                'not null' => true,
                'length' => 20),
            'value' => array(
                'mysql_type' => 'double',
                'type' => 'numeric',
                'precision' => 7,
                'scale' => 4,
                'not null' => true,
                'unsigned' => true),
            'created' => array(
                'type' => 'int',
                'not null' => true,
                'unsigned' => true)
        ),
        'foreign keys' => array(
            'stock' => array(
                'table' => 'stock_profile',
                'columns' => array('id' => 'stock_id', 'symbol' => 'stock_symbol')
            )
        ),
        'primary key' => array('id'),
        'indexes' => array(
            'date' => array('created'),
            'stock' => array('stock_symbol', 'stock_id')
        )
    );
    
    $schema['stock_investor'] = array(
        'description' => 'Stores the details of investors of stocks',
        'fields' => array(
            'id' => array(
                'type' => 'serial',
                'not null' => true,
                'unsigned' => true,
                'size' => 'big'),
            'stock_id' => array(
                'type' => 'int',
                'not null' => true,
                'unsigned' => true),
            'stock_symbol' => array(
                'type' => 'varchar',
                'not null' => true,
                'length' => 20),
            'type1' => array(
                'type' => 'float',
                'not null' => false,
                'default' => NULL),
            'type2' => array(
                'type' => 'float',
                'not null' => false,
                'default' => NULL),
            'type3' => array(
                'type' => 'float',
                'not null' => false,
                'default' => NULL),
            'type4' => array(
                'type' => 'float',
                'not null' => false,
                'default' => NULL),
            'type5' => array(
                'type' => 'float',
                'not null' => false,
                'default' => NULL),
            'type6' => array(
                'type' => 'float',
                'not null' => false,
                'default' => NULL),
            'type7' => array(
                'type' => 'float',
                'not null' => false,
                'default' => NULL),
            'type8' => array(
                'type' => 'float',
                'not null' => false,
                'default' => NULL),
            'type9' => array(
                'type' => 'float',
                'not null' => false,
                'default' => NULL),
            'created' => array(
                'type' => 'int',
                'not null' => true,
                'unsigned' => true)
        ),
        'foreign keys' => array(
            'stock' => array(
                'table' => 'stock_profile',
                'columns' => array('id' => 'stock_id', 'symbol' => 'stock_symbol')
            )
        ),
        'primary key' => array('id'),
        'indexes' => array(
            'date' => array('created'),
            'stock' => array('stock_symbol', 'stock_id')
        )
    );
    
    $schema['stock_history'] = array(
        'description' => 'Stock Price and Volume History obtained at the close of the day',
        'fields' => array(
            'id' => array(
                'type' => 'serial',
                'not null' => true,
                'unsigned' => true,
                'size' => 'big'),
            'stock_id' => array(
                'type' => 'int',
                'not null' => true,
                'unsigned' => true),
            'stock_symbol' => array(
                'type' => 'varchar',
                'not null' => true,
                'length' => 20),
            'open' => array(
                'mysql_type' => 'double',
                'type' => 'numeric',
                'precision' => 13,
                'scale' => 4,
                'not null' => false,
                'default' => NULL,
                'unsigned' => true),
            'close' => array(
                'mysql_type' => 'double',
                'type' => 'numeric',
                'precision' => 13,
                'scale' => 4,
                'not null' => false,
                'default' => NULL,
                'unsigned' => true),
            'high' => array(
                'mysql_type' => 'double',
                'type' => 'numeric',
                'precision' => 13,
                'scale' => 4,
                'not null' => false,
                'default' => NULL,
                'unsigned' => true),
            'low' => array(
                'mysql_type' => 'double',
                'type' => 'numeric',
                'precision' => 13,
                'scale' => 4,
                'not null' => false,
                'default' => NULL,
                'unsigned' => true),
            'volume' => array(
                'mysql_type' => 'int(15)',
                'type' => 'numeric',
                'not null' => false,
                'default' => NULL,
                'unsigned' => true),
            'date' => array(
                'mysql_type' => 'date',
                'type' => 'date',
                'not null' => false,
